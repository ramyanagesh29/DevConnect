generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String
  bio       String?
  githubUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}